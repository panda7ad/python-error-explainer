{
  "compilerOptions": {
    "types": ["node"],
    "module": "Node16",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true
  },
  "exclude": ["node_modules", ".vscode-test"]
}
